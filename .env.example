# Copy to .env and adjust. docker compose reads .env automatically.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
# Host port for the API gateway. Override if something else on your machine already
# claims 8080 (it is heavily contended on Windows -- backup agents and vendor tools love
# it). The container always listens on 8080 internally; this only remaps the host side.
GATEWAY_PORT=8080

POSTGRES_PASSWORD=postgres
MINIO_ROOT_USER=careerpilot
MINIO_ROOT_PASSWORD=careerpilot123
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Vite dev server and CRA defaults. Add your frontend origin here if it differs.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# JWT signing keys
# ---------------------------------------------------------------------------
# Leave BOTH blank for development: identity-service generates an ephemeral keypair at
# startup and warns about it. Tokens then die on every restart, which is fine locally.
#
# For keys that survive restarts, run scripts/generate-keys.sh (or .ps1) and uncomment:
# JWT_PRIVATE_KEY_LOCATION=file:/run/keys/jwt-private.pem
# JWT_PUBLIC_KEY_LOCATION=file:/run/keys/jwt-public.pem
JWT_PRIVATE_KEY_LOCATION=
JWT_PUBLIC_KEY_LOCATION=

# ---------------------------------------------------------------------------
# Job providers (job-service, week 2)
# ---------------------------------------------------------------------------
# Remotive, Arbeitnow and RemoteOK need no key and are always available -- the demo works
# offline-ish without anything below.
#
# Adzuna is the only source with salary data and real (non-remote-only) locations, so
# location-based matching depends on it. Free key, instant signup:
#   https://developer.adzuna.com/
#
# Budget note: the free tier is ~1,000 calls per MONTH (~33/day). That constraint is why
# ingestion is scheduled and Redis-cached rather than per-user-request -- do not burn it
# with a tight polling loop during development.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# ---------------------------------------------------------------------------
# Apify job-board scraper -- the ONLY verified source of Dhaka/Bangladesh jobs
# ---------------------------------------------------------------------------
# Free account, no card: https://apify.com  (Settings -> Integrations -> API token)
# Billed ~$0.003 per job against a $5/month free credit (~1,600 jobs). Exceeding the
# credit blocks the account until the next cycle, so keep max-results modest.
# Verified working via LinkedIn; the actor's own bdjobs/google boards return nothing.
APIFY_TOKEN=
APIFY_LOCATION=Dhaka, Bangladesh
APIFY_MAX_RESULTS=25

# ---------------------------------------------------------------------------
# Optional LLM resume feedback (resume-service, feature-flagged OFF)
# ---------------------------------------------------------------------------
# The deterministic pipeline (TF-IDF, Aho-Corasick skills, rule-based checks) is the
# product. This only adds phrasing rewrites on top, behind a circuit breaker.
# With the flag false, nothing here is read and no network call is made.
CAREERPILOT_AI_ENABLED=false
ANTHROPIC_API_KEY=
